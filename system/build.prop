ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=256
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=512

#Extended smarthome discovery timeout in msec
persist.sh_discovery_timeout=40000

# Whole home audio play at offset in nanoseconds.
# This is used to compensate for a measured constant offset
# in this device's audio pipeline from that of a reference device
# (currently biscuit line out).
persist.wha_offset_ns=-43399000
#same as above, but for line out.
persist.wha_lineout_offset_ns=46000

