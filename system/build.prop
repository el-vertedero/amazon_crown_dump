wifi.direct.interface=p2p0
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=256m

# USB MTP WHQL
ro.sys.usb.mtp.whql.enable=0
ro.usb.vid=1949

# Power off opt in IPO
sys.ipo.pwrdncap=2

ro.sys.usb.storage.type=mtp,mass_storage

# USB BICR function
ro.sys.usb.bicr=yes

# USB Charge only function
ro.sys.usb.charging.only=yes

# audio
ro.camera.sound.forced=0
ro.audio.silent=0

ro.zygote.preload.enable=0

# temporary enables NAV bar (soft keys)
qemu.hw.mainkeys=1

ro.kernel.zio=38,108,105,16
#ro.kernel.qemu=1
#ro.kernel.qemu.gles=0
ro.boot.selinux=disable

# Enable logcat kernel logs for userbuild with boolean 'true'
ro.logd.kernel=true

# Disable partial updates (formerly known as 'dirty region') for Mali
debug.hwui.use_partial_updates=false

ro.sf.lcd_density=213

# disable ipo for development
sys.ipo.disable=1

#for mali
ro.hardware.gralloc=mt8163.mali

#Audio rotation
ro.audio.monitorRotation=true

#audio
dolby.ds.settings.filename=ds1-0033.xml

#hardware smartvolume support for headset|headphone
ro.audio.hw_vol_devices=0x0C

# maximum backup size for factory reset whitelist in KB
ro.recovery.wl.maxstore=524288

# wifi rssi->bar thresholds
persist.wifi.rssi.thresholds=-92,-79,-70,-60

#Disable Bluetooth Absolute volume
persist.bluetooth.disableabsvol=true

# Reserve WHA server ports.
sys.sysctl.ip_loc_res_ports=55442-55445

# Set landscape by default
ro.fireos.display.rotation=90

#hwui properities
