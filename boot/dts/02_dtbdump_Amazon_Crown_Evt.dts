					phandle = <0x10a>;
				};

				trip-point@8 {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
					linux,phandle = <0x10b>;
					phandle = <0x10b>;
				};
			};
		};

		therm0_s {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			policy = "step_wise";
			thermal-sensors = <0x60>;
