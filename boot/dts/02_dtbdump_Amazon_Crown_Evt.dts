		phandle = <0xf8>;
	};

	audio_cooler {
		compatible = "amazon,thermal_cooler";
		#cooling-cells = <0x02>;
		max_level = <0x03>;
		max_state = <0x08>;
		linux,phandle = <0xf9>;
		phandle = <0xf9>;
	};

	suspend_cooler {
		compatible = "amazon,thermal_cooler";
		#cooling-cells = <0x02>;
		max_state = <0x02>;
		linux,phandle = <0xfa>;
		phandle = <0xfa>;
	};

	led@6 {
		compatible = "mediatek,lcd-backlight";
		led_mode = <0x05>;
		data;
		pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		gpios = <0x0e 0x3b 0x00>;
	};

	lcm@0 {
		compatible = "lcm,lcm_dts_jd936x_crown";
		pinctrl-names = "default";
		lcm_auxadc_channel = <0x00>;
		lcm_reset_gpio = <0x0e 0x53 0x00>;
		lcm_power_p_gpio = <0x0e 0x08 0x00>;
		lcm_power_n_gpio = <0x0e 0x09 0x00>;
		lcm-vio-supply = <0x5b>;
		status = "okay";
		linux,phandle = <0xfb>;
		phandle = <0xfb>;
	};

	keysilent-ota {
		compatible = "amzn,silent-ota";
		keys_down = "KEY_POWER";
		keys_down_delay = <0x00>;
		status = "okay";
	};

	thermal-zones {

		skin_virtual {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			policy = "step_wise";
			thermal-sensors = <0x5e>;

			trips {

				trip-point@0 {
					temperature = <0xa7f8>;
					hysteresis = <0x00>;
					type = "passive";
					linux,phandle = <0xfc>;
					phandle = <0xfc>;
				};

				trip-point@1 {
					temperature = <0xbb80>;
					hysteresis = <0x7d0>;
					type = "passive";
					linux,phandle = <0xfd>;
					phandle = <0xfd>;
				};

				trip-point@2 {
					temperature = <0xc350>;
					hysteresis = <0x5dc>;
					type = "passive";
