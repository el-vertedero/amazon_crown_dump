/dts-v1/;

/ {
	model = "Amazon Crown Evt";
	compatible = "amzn,crown-evt";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	version = "evt";

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x00 0xf9 0x00>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x02>;
			reg = <0x00>;
			enable-method = "mt-boot";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = "M|m";
			#cooling-cells = <0x02>;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x02>;
			reg = <0x01>;
			enable-method = "mt-boot";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = "M|m";
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x02>;
			reg = <0x02>;
			enable-method = "mt-boot";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = "M|m";
			linux,phandle = <0x07>;
			phandle = <0x07>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x02>;
			reg = <0x03>;
			enable-method = "mt-boot";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = "M|m";
			linux,phandle = <0x08>;
			phandle = <0x08>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};
			};
		};

		l2-cache0 {
			compatible = "cache";
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x4b0>;
				linux,phandle = <0x04>;
				phandle = <0x04>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010000>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x7d0>;
				linux,phandle = <0x03>;
				phandle = <0x03>;
			};
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		linux,phandle = <0x64>;
		phandle = <0x64>;

		atf-reserved-memory {
			compatible = "mediatek,mt8163-atf-reserved-memory";
			no-map;
			reg = <0x00 0x43000000 0x00 0x30000>;
			linux,phandle = <0x65>;
			phandle = <0x65>;
		};

		ram_console-reserved-memory {
			compatible = "mediatek,ram_console";
			reg = <0x00 0x44400000 0x00 0x10000>;
		};

		pstore-reserved-memory {
			compatible = "mediatek,pstore";
			reg = <0x00 0x44410000 0x00 0xe0000>;
		};

		minirdump-reserved-memory {
			compatible = "mediatek,minirdump";
			reg = <0x00 0x444f0000 0x00 0x10000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x00 0x200000>;
			alignment = <0x00 0x200000>;
		};

		secure-carveout {
			compatible = "shared-secure-pool";
			reusable;
			size = <0x00 0x00>;
			linux,phandle = <0x66>;
			phandle = <0x66>;
		};
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0x84000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0x84000003>;
		affinity_info = <0x84000004>;
	};

	clocks {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			linux,phandle = <0x31>;
			phandle = <0x31>;
		};

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
			linux,phandle = <0x13>;
			phandle = <0x13>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			linux,phandle = <0x67>;
			phandle = <0x67>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x09>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0xc65d40>;
		arm,no-tick-in-suspend;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		chipid@08000000 {
			compatible = "mediatek,mt8163-chipid";
			reg = <0x00 0x8000000 0x00 0x10>;
			linux,phandle = <0x68>;
			phandle = <0x68>;
		};

		topckgen@10000000 {
			compatible = "mediatek,mt8163-topckgen";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		infracfg@10001000 {
			compatible = "mediatek,mt8163-infracfg\0syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		syscfg_pctl_a@10005000 {
			compatible = "mediatek,mt8163-pctl-a-syscfg\0syscon";
			reg = <0x00 0x10005000 0x00 0x1000>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		toprgu@10007000 {
			compatible = "mediatek,mt8163-rgu\0mediatek,mt6589-wdt";
			reg = <0x00 0x10007000 0x00 0x1000>;
			interrupts = <0x00 0x80 0x02>;
			#reset-cells = <0x01>;
			linux,phandle = <0x47>;
			phandle = <0x47>;
		};

		apxgpt@10008000 {
			compatible = "mediatek,mt8163-timer\0mediatek,mt6577-timer";
			reg = <0x00 0x10008000 0x00 0x1000>;
			interrupts = <0x00 0x98 0x08>;
			clocks = <0x0a 0x06 0x0a 0x46 0x0b 0x60>;
			clock-names = "bus\0clk13m\0clk32k";
			linux,phandle = <0x69>;
			phandle = <0x69>;
		};

		pmu {
			compatible = "arm,armv8-pmuv3\0arm,cortex-a7-pmu";
			interrupts = <0x00 0x08 0x08 0x00 0x09 0x08 0x00 0x0a 0x08 0x00 0x0b 0x08>;
			interrupt-affinity = <0x05 0x06 0x07 0x08>;
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8163-pinctrl";
			reg = <0x00 0x1000b000 0x00 0x1000>;
			mediatek,pctl-regmap = <0x0c>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x99 0x04 0x00 0x9a 0x04 0x00 0x9b 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x0d>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;

			spi1 {
				linux,phandle = <0x1a>;
				phandle = <0x1a>;

				pins_spi {
					pinmux = <0x3501 0x3601 0x3701 0x3801>;
					bias-disable;
					drive-strength = <0x06>;
					input-schmitt-enable;
					linux,phandle = <0x6a>;
					phandle = <0x6a>;
				};
			};

			uart0_pin_default {
				linux,phandle = <0x10>;
				phandle = <0x10>;

				pins_rx {
					pinmux = <0x4f01>;
					input-enable;
					bias-pull-up;
				};

				pins_tx {
					pinmux = <0x5001>;
				};
			};

			pinconf_default {
				linux,phandle = <0x0d>;
				phandle = <0x0d>;
			};

			eint4default {
				linux,phandle = <0x50>;
				phandle = <0x50>;
			};

			eint4 {
				linux,phandle = <0x51>;
				phandle = <0x51>;

				pins_cmd_dat {
					pinmux = <0x1a00>;
					bias-disable;
				};
			};

			gpiodefault {
				linux,phandle = <0x5c>;
				phandle = <0x5c>;

				pins_cmd_dat {
					pinmux = <0x2400 0x2500>;
					slew-rate = <0x00>;
					bias-pull-up = <0x65>;
					input-enable;
				};
			};

			alspspincfg {
				linux,phandle = <0x59>;
				phandle = <0x59>;

				pins_cmd_dat {
					pinmux = <0x3400>;
					slew-rate = <0x00>;
					bias-pull-up = <0x00>;
				};
			};

			alspsdefaultcfg {
				linux,phandle = <0x58>;
				phandle = <0x58>;
			};

			audiodefault {
				linux,phandle = <0x2c>;
				phandle = <0x2c>;

				pins1 {
					pinmux = <0x1203 0x1303 0x1403 0x1503>;
				};
			};

			spidefault {
				linux,phandle = <0x1b>;
				phandle = <0x1b>;
			};

			audioadcdefault {
				linux,phandle = <0x16>;
				phandle = <0x16>;
			};

			audioadcmclk {
				linux,phandle = <0x17>;
				phandle = <0x17>;

				pins_cmd_dat {
					pinmux = <0x604>;
				};
			};

			pmicclkmode0 {
				linux,phandle = <0x1c>;
				phandle = <0x1c>;
			};

			pmicclkmode1 {
				linux,phandle = <0x1d>;
				phandle = <0x1d>;
			};

			audi2s1mode0 {
				linux,phandle = <0x1e>;
				phandle = <0x1e>;

				pins_cmd0_dat {
					pinmux = <0x4800>;
				};

				pins_cmd1_dat {
					pinmux = <0x4900>;
				};

				pins_cmd2_dat {
					pinmux = <0x4a00>;
				};
			};

			audi2s1mode1 {
				linux,phandle = <0x1f>;
				phandle = <0x1f>;

				pins_cmd0_dat {
					pinmux = <0x4804>;
					drive-strength = <0x08>;
				};

				pins_cmd1_dat {
					pinmux = <0x4904>;
					drive-strength = <0x08>;
				};

				pins_cmd2_dat {
					pinmux = <0x4a04>;
					drive-strength = <0x08>;
				};
			};

			audexamphigh {
				linux,phandle = <0x20>;
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			audexamplow {
				linux,phandle = <0x21>;
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			audmicen {
				linux,phandle = <0x22>;
				phandle = <0x22>;

				pins_cmd0_dat {
					pinmux = <0x2e00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			audmicdisable {
				linux,phandle = <0x2d>;
				phandle = <0x2d>;

				pins_cmd0_dat {
					pinmux = <0x2e00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			camdefault {
				linux,phandle = <0x3c>;
				phandle = <0x3c>;
			};

			cam0@0 {
				linux,phandle = <0x3e>;
				phandle = <0x3e>;

				pins_cmd_dat {
					pinmux = <0x1600>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam0@1 {
				linux,phandle = <0x3f>;
				phandle = <0x3f>;

				pins_cmd_dat {
					pinmux = <0x1600>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam0@2 {
				linux,phandle = <0x40>;
				phandle = <0x40>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam0@3 {
				linux,phandle = <0x41>;
				phandle = <0x41>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam1@0 {
				linux,phandle = <0x6b>;
				phandle = <0x6b>;

				pins_cmd_dat {
					pinmux = <0x1600>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam1@1 {
				linux,phandle = <0x6c>;
				phandle = <0x6c>;

				pins_cmd_dat {
					pinmux = <0x1600>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam1@2 {
				linux,phandle = <0x6d>;
				phandle = <0x6d>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam1@3 {
				linux,phandle = <0x6e>;
				phandle = <0x6e>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam_pin_rdn0 {
				linux,phandle = <0x42>;
				phandle = <0x42>;

				pins_cmd_dat {
					pinmux = <0x6501>;
				};
			};

			cam_pin_rdp0 {
				linux,phandle = <0x43>;
				phandle = <0x43>;

				pins_cmd_dat {
					pinmux = <0x6601>;
				};
			};

			cam_pin_rcn {
				linux,phandle = <0x44>;
				phandle = <0x44>;

				pins_cmd_dat {
					pinmux = <0x6901>;
				};
			};

			cam_pin_rcp {
				linux,phandle = <0x45>;
				phandle = <0x45>;

				pins_cmd_dat {
					pinmux = <0x6a01>;
				};
			};

			cam_pin_rcn_a {
				linux,phandle = <0x6f>;
				phandle = <0x6f>;

				pins_cmd_dat {
					pinmux = <0x6f01>;
				};
			};

			cam_pin_rcp_a {
				linux,phandle = <0x70>;
				phandle = <0x70>;

				pins_cmd_dat {
					pinmux = <0x7001>;
				};
			};

			cam_pin_rdn0_a {
				linux,phandle = <0x71>;
				phandle = <0x71>;

				pins_cmd_dat {
					pinmux = <0x7301>;
				};
			};

			cam_pin_rdp0_a {
				linux,phandle = <0x72>;
				phandle = <0x72>;

				pins_cmd_dat {
					pinmux = <0x7401>;
				};
			};

			cam_pin_mclk {
				linux,phandle = <0x3d>;
				phandle = <0x3d>;

				pins_cmd_dat {
					pinmux = <0x7701>;
				};
			};

			default {
				linux,phandle = <0x48>;
				phandle = <0x48>;
			};

			rstoutput0 {
				linux,phandle = <0x56>;
				phandle = <0x56>;

				pins_cmd_dat {
					pinmux = <0x7b00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			rstoutput1 {
				linux,phandle = <0x57>;
				phandle = <0x57>;

				pins_cmd_dat {
					pinmux = <0x7b00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			eint0default {
				linux,phandle = <0x52>;
				phandle = <0x52>;

				pins_cmd_dat {
					pinmux = <0x7a00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			eint@0 {
				linux,phandle = <0x53>;
				phandle = <0x53>;

				pins_cmd_dat {
					pinmux = <0x7a00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			eintoutput0 {
				linux,phandle = <0x54>;
				phandle = <0x54>;

				pins_cmd_dat {
					pinmux = <0x7a00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			pins_cmd2_dat {
				pinmux = <0x3801>;
			};

			eintoutput1 {
				linux,phandle = <0x55>;
				phandle = <0x55>;

				pins_cmd_dat {
					pinmux = <0x7a00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			iddig_irq_init {
				linux,phandle = <0x26>;
				phandle = <0x26>;

				pins_cmd_dat {
					pinmux = <0x2600>;
					bias-pull-up;
				};
			};

			iddig_irq_low {
				linux,phandle = <0x27>;
				phandle = <0x27>;

				pins_cmd_dat {
					pinmux = <0x2600>;
					bias-pull-down;
				};
			};

			iddig_irq_high {
				linux,phandle = <0x28>;
				phandle = <0x28>;

				pins_cmd_dat {
					pinmux = <0x2600>;
					bias-pull-up;
				};
			};

			wifipwon@0 {
				linux,phandle = <0x49>;
				phandle = <0x49>;

				pins_cmd_dat {
					pinmux = <0x1c00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			wifipwoff@1 {
				linux,phandle = <0x4a>;
				phandle = <0x4a>;

				pins_cmd_dat {
					pinmux = <0x1c00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			wifigp0@0 {
				linux,phandle = <0x4b>;
				phandle = <0x4b>;

				pins_cmd_dat {
					pinmux = <0x1d00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			wifint@0 {
				linux,phandle = <0x4c>;
				phandle = <0x4c>;

				pins_cmd_dat {
					pinmux = <0x1e00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			bgfint@0 {
				linux,phandle = <0x4d>;
				phandle = <0x4d>;

				pins_cmd_dat {
					pinmux = <0x1f00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			pmupwen@0 {
				linux,phandle = <0x4e>;
				phandle = <0x4e>;

				pins_cmd_dat {
					pinmux = <0x2000>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mcsync@0 {
				linux,phandle = <0x4f>;
				phandle = <0x4f>;

				pins_cmd_dat {
					pinmux = <0x2100>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			i2c0@0 {
				linux,phandle = <0x12>;
				phandle = <0x12>;

				pins1 {
					pinmux = <0x4b01 0x4c01>;
					bias-disable;
				};
			};

