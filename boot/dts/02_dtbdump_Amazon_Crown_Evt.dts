					hysteresis = <0x00>;
					type = "critical";
					linux,phandle = <0x102>;
					phandle = <0x102>;
				};
			};
		};

		case_virtual {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			policy = "step_wise";
			thermal-sensors = <0x5f>;

			trips {

				trip-point@0 {
					temperature = <0x153d8>;
					hysteresis = <0x00>;
					type = "passive";
					linux,phandle = <0x103>;
					phandle = <0x103>;
				};

				trip-point@1 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					linux,phandle = <0x104>;
					phandle = <0x104>;
				};

				trip-point@2 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					linux,phandle = <0x105>;
					phandle = <0x105>;
				};

				trip-point@3 {
					temperature = <0x17ae8>;
					hysteresis = <0x5dc>;
					type = "passive";
					linux,phandle = <0x106>;
					phandle = <0x106>;
				};

				trip-point@4 {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "passive";
					linux,phandle = <0x107>;
					phandle = <0x107>;
				};

				trip-point@5 {
					temperature = <0x19258>;
					hysteresis = <0xfa0>;
					type = "passive";
